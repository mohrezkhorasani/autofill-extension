{
  "manifest_version": 3,
  "name": "Mohrez Quick Autofill",
  "version": "1.0.0",
  "description": "دستیار هوشمند پر کردن خودکار فرم‌ها و فیلدهای متنی با یک کلیک و قابلیت ذخیره آنی",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Mohrez Quick Autofill"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:23157/*",
    "http://localhost:23157/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "autofill@mohrez.local",
      "strict_min_version": "109.0"
    }
  }
}
